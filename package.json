{
  "name": "wordpress-boilerplate",
  "version": "1.0.0",
  "description": "A clean boilerplate for classic WordPress theme development with Tailwind CSS.",
  "author": "Your Name",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./src/css/tailwind.css -o ./assets/css/main.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./src/css/tailwind.css -o ./assets/css/main.css --watch",
    "build:js": "npx esbuild src/js/main.js --bundle --outfile=assets/js/main.js --minify",
    "watch:js": "npx esbuild src/js/main.js --bundle --outfile=assets/js/main.js --watch",
    "build": "npm run build:css && npm run build:js",
    "watch": "npm run watch:css & npm run watch:js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "esbuild": "^0.25.12",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@parcel/watcher@2.5.1": true
  }
}
